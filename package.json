{
  "name": "bkk-flood-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p scripts && tsc --noEmit -p tests && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "data:fetch": "node scripts/data.ts --stage=fetch",
    "data:build": "node scripts/data.ts --stage=build",
    "data:report": "node scripts/data.ts --stage=report",
    "data:forecast": "node scripts/build-forecast-normals.ts",
    "data": "node scripts/data.ts"
  },
  "dependencies": {
    "three": "^0.160.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/three": "^0.160.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "geotiff": "^3.0.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
